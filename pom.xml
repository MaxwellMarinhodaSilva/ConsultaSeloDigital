<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.selodigital</groupId>

    <artifactId>ConsultaSeloDigital</artifactId>

    <version>2.2.6</version>

    <properties>

        <!-- Nome da aplicação -->
        <app.name>${project.artifactId}</app.name>

        <!-- Classe principal -->
        <app.mainClass>com.selodigital.ConsultaSeloDigital</app.mainClass>

        <!-- Ícone do EXE -->
        <app.icon>${project.basedir}/icones/com.selodigital.ConsultaSeloDigital.ico</app.icon>

        <!-- Pasta de saída -->
        <app.dest>${project.basedir}/dist</app.dest>

        <!-- Java -->
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Codificação -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Versões -->
        <flatlaf.version>3.6</flatlaf.version>

        <jackson.version>2.21.5</jackson.version>

    </properties>


    <dependencies>

        <!-- Interface gráfica -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>${flatlaf.version}</version>
        </dependency>


        <!-- JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>


        <!-- QR Code -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>

        <!-- Exportação de documentos -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.30</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.3</version>
        </dependency>


        <!-- Testes -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <build>

        <plugins>


            <!-- Compilador Java -->
            <plugin>

                <groupId>org.apache.maven.plugins</groupId>

                <artifactId>maven-compiler-plugin</artifactId>

                <version>3.13.0</version>

                <configuration>

                    <release>${maven.compiler.release}</release>

                </configuration>

            </plugin>


            <!-- Cria JAR com todas as dependências -->
            <plugin>

                <groupId>org.apache.maven.plugins</groupId>

                <artifactId>maven-assembly-plugin</artifactId>

                <version>3.7.1</version>

                <configuration>

                    <archive>

                        <manifest>

                            <mainClass>${app.mainClass}</mainClass>

                        </manifest>

                    </archive>


                    <descriptorRefs>

                        <descriptorRef>jar-with-dependencies</descriptorRef>

                    </descriptorRefs>

                </configuration>


                <executions>

                    <execution>

                        <id>make-assembly</id>

                        <phase>package</phase>

                        <goals>

                            <goal>single</goal>

                        </goals>

                    </execution>

                </executions>

            </plugin>


            <!-- Cria o EXE usando jpackage -->
            <plugin>

                <groupId>org.codehaus.mojo</groupId>

                <artifactId>exec-maven-plugin</artifactId>

                <version>3.5.0</version>


                <executions>

                    <execution>

                        <id>gerar-app-image</id>

                        <phase>package</phase>


                        <goals>

                            <goal>exec</goal>

                        </goals>


                        <configuration>

                            <executable>jpackage</executable>


                            <workingDirectory>${project.basedir}</workingDirectory>


                            <arguments>


                                <!-- Tipo da aplicação -->
                                <argument>--type</argument>
                                <argument>app-image</argument>


                                <!-- Nome -->
                                <argument>--name</argument>
                                <argument>${app.name}</argument>


                                <!-- JAR de entrada -->
                                <argument>--input</argument>
                                <argument>target</argument>


                                <!-- JAR com dependências -->
                                <argument>--main-jar</argument>
                                <argument>${project.artifactId}-${project.version}-jar-with-dependencies.jar</argument>


                                <!-- Classe principal -->
                                <argument>--main-class</argument>
                                <argument>${app.mainClass}</argument>


                                <!-- Ícone -->
                                <argument>--icon</argument>
                                <argument>${app.icon}</argument>


                                <!-- Pasta de saída -->
                                <argument>--dest</argument>
                                <argument>${app.dest}</argument>


                            </arguments>

                        </configuration>

                    </execution>

                </executions>

            </plugin>


            <!-- Testes -->
            <plugin>

                <groupId>org.apache.maven.plugins</groupId>

                <artifactId>maven-surefire-plugin</artifactId>

                <version>3.5.2</version>

            </plugin>


        </plugins>

    </build>

</project>
